# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# FastAPI backend
# For a single Lightsail server, Next.js can use the internal address.
STFL_BACKEND_URL=http://127.0.0.1:8001

# Optional public fallback used by selected proxy routes.
NEXT_PUBLIC_BACKEND_URL=https://api.sharetradingforliving.com

# Internal synchronization — must match backend values
STFL_SCREENER_SYNC_TOKEN=
STFL_CORPORATE_ACTION_SYNC_TOKEN=

# Upstox
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=https://sharetradingforliving.com/api/upstox/callback
UPSTOX_ANALYTICS_TOKEN=

# Market and news providers
NEXT_PUBLIC_FINNHUB_API_KEY=
NEWSAPI_KEY=

# Frontend IPO provider
IPO_GURU_API_KEY=